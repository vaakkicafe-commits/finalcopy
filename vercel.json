{
  "cleanUrls": true,
  "routes": [
    { "src": "/farm.html", "dest": "/public/farm.html" },
    { "src": "/tech.html", "dest": "/public/tech.html" },
    { "src": "/index.html", "dest": "/public/index.html" },
